.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Interactive charts (regenerated by compare_results.py; PNG exports are tracked instead)
results/*.html

# Per-query metrics (intermediate, regenerated by evaluate.py)
results/per_query/
